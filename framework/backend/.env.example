# Copy to .env and configure locally. Never commit .env or real API keys.
DATABASE_URL=sqlite:///./railway.db
SECRET_KEY=replace-with-a-new-random-secret-before-running
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
