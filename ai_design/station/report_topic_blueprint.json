      "key": "lab-01-01",
      "topic": 1,
      "sequence": 1,
      "title": "道岔单操：单锁、占用与封闭的区别",
      "source_section": "实验1 · 三、1（1）—（4）",
      "prompt": "以原图5/7、9/11号道岔为对象。每一行均为独立工况，除列明条件外，道岔有表示、区段空闲且未被进路锁闭。分别判断能否转换，并解释“封闭”和“单锁”的区别。",
      "fields": [
        {
          "id": "free",
          "label": "5/7号道岔无锁闭、无故障，办理总定/总反",
          "kind": "choice",
          "points": 10,
          "options": [
            "能转换",
            "不能转换"
          ],
          "expected": "能转换",
          "explanation": "报告单操示例明确：正常状态可以总定、总反。"
        },
        {
          "id": "locked",
          "label": "9/11号道岔已单锁，再要求改变位置",
          "kind": "choice",
          "points": 10,
          "options": [
            "能转换",
            "不能转换"
          ],
          "expected": "不能转换",
          "explanation": "单锁用于保持道岔位置；报告明确单锁后不能转换。"
        },
        {
          "id": "occupied",
          "label": "7DG占用，要求5/7号道岔转换",
          "kind": "choice",
          "points": 10,
          "options": [
            "能转换",
            "不能转换"
          ],
          "expected": "不能转换",
          "explanation": "7号道岔位于7DG，双动道岔任一相关区段占用均不能按正常单操转换。"
        },
        {
          "id": "sealed",
          "label": "5/7号道岔仅封闭，再办理总定/总反",
          "kind": "choice",
          "points": 10,
          "options": [
            "能转换",
            "不能转换"
          ],
          "expected": "能转换",
          "explanation": "报告明确封闭后总定总反仍能转换，不能将封闭等同于单锁。"
        },
        {
          "id": "reason",
          "label": "解释单锁与封闭分别限制什么，并说明混淆二者会造成怎样的判断错误。",
          "kind": "essay",
          "points": 10,
          "criteria": [
            "区分位置保持和进路选用限制",
            "结合上述两组道岔解释",
            "不得仅以“都不能办理”概括"
          ]
        }
      ],
      "devices": [
        "5/7",
